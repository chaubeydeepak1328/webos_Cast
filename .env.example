# Cast to webOS TV -- local configuration.
# Copy to .env. Everything here is optional; the only value you cannot
# discover automatically is WEBOS_CLIENT_KEY, and `npm run pair` writes
# that one for you.

# IP address of the TV. Leave blank to discover it over SSDP.
WEBOS_TV_IP=

# Pairing key returned by the TV the first time you accept the on-screen
# prompt. `npm run pair` fills this in automatically -- do not type it by hand.
WEBOS_CLIENT_KEY=

# LAN IP of THIS machine, advertised to the TV. Leave blank to auto-detect
# the adapter that shares the TV's subnet.
LOCAL_LAN_IP=

# Local HTTP port for the stream.
WEBOS_PORT=7337

# Capture tuning.
WEBOS_FRAMERATE=15
WEBOS_WIDTH=1280
WEBOS_QUALITY=6
WEBOS_MONITOR=0

# Path to ffmpeg, if it is not on PATH.
FFMPEG_PATH=ffmpeg
